        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/action_primary_soft</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>
        <item name="colorSecondary">@color/action_primary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/screen_background</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:windowBackground">@color/screen_background</item>
        <item name="android:statusBarColor">@color/toolbar_background</item>
        <item name="android:navigationBarColor">@color/screen_background</item>
        <item name="android:windowLightStatusBar">false</item>
